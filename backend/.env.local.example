# ============================================
# DRISHTI Backend Environment Configuration
# ============================================
#
# IMPORTANT: This is a template file.
# 1. Copy this to a new file named ".env" (without .example)
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit the real .env file to git
#

# ============================================
# DATABASE CONNECTION
# ============================================
# Neon (PostgreSQL) — copy the connection string from your Neon project
# dashboard, then prefix it with "postgresql+psycopg2://" so SQLAlchemy uses
# the psycopg2 driver. Neon requires sslmode=require.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<your-neon-host>/<dbname>?sslmode=require

# Local development without Neon (optional, needs local Postgres installed):
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/drishti_db

# ============================================
# JWT SECRET KEY (CRITICAL - MUST CHANGE)
# ============================================
# Generate a secure random key using one of these methods:
#
# Option 1 (Recommended - OpenSSL):
#   openssl rand -hex 32
#
# Option 2 (Python):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Option 3 (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | % {[char]$_})
#
SECRET_KEY=REPLACE_THIS_WITH_OUTPUT_FROM_OPENSSL_RAND_HEX_32

# ============================================
# JWT CONFIGURATION
# ============================================
# Algorithm for token signing (DO NOT CHANGE unless you know what you're doing)
ALGORITHM=HS256

# Token expiration time in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Local development:
FRONTEND_URL=http://localhost:5173

# Production (Vercel):
# FRONTEND_URL=https://drishti-app-five.vercel.app

# ============================================
# DEPLOYMENT NOTES
# ============================================
#
# For Railway/Render Deployment (backend host):
# 1. Create your database first at neon.tech (see DEPLOYMENT.md)
# 2. Go to your Railway/Render project dashboard -> backend service -> Variables
# 3. Add these environment variables:
#    - DATABASE_URL (the Neon connection string, with postgresql+psycopg2:// prefix)
#    - SECRET_KEY (paste the generated key)
#    - FRONTEND_URL (your Vercel URL)
#
# For Local Development:
# 1. Create a free project at neon.tech and copy its connection string, OR
#    install PostgreSQL locally and create a database: CREATE DATABASE drishti_db;
# 2. Run the schema: psql "<your DATABASE_URL>" -f db/schema_postgres.sql
# 3. Copy this file to .env and fill in your values
# 4. Run: uvicorn app.main:app --reload
#
