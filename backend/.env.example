# Copy this to a real ".env" file for local development, or configure these as
# Environment Variables in Railway/Render for production deployment.

# Neon (PostgreSQL) connection string — copy from Neon dashboard, then prefix
# the driver as shown below. Neon requires sslmode=require.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<your-neon-host>/<dbname>?sslmode=require
# Generate a strong 32+ char key using: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-long-secure-random-secret-key-at-least-32-chars
FRONTEND_URL=http://localhost:5173

